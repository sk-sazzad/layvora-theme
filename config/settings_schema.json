    "theme_documentation_url": "https://layvora.com",
    "theme_support_url": "https://layvora.com/support"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color (Orange)",
        "default": "#FF6B35"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary color (Navy)",
        "default": "#1A1A2E"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color (Gold)",
        "default": "#FFD700"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_light_bg",
        "label": "Light background color",
        "default": "#FFF8F5"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success / COD color (Green)",
        "default": "#27AE60"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text color",
        "default": "#1A1A2E"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text color",
        "default": "#777799"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border color",
        "default": "#E8E8F0"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "font_arabic",
        "label": "Arabic font",
        "options": [
          { "value": "Tajawal", "label": "Tajawal (Recommended)" },
          { "value": "Cairo", "label": "Cairo" },
          { "value": "Almarai", "label": "Almarai" },
          { "value": "Noto Sans Arabic", "label": "Noto Sans Arabic" }
        ],
        "default": "Tajawal"
      },
      {
        "type": "select",
        "id": "font_english",
        "label": "English font",
        "options": [
          { "value": "Inter", "label": "Inter (Recommended)" },
          { "value": "Poppins", "label": "Poppins" },
          { "value": "Outfit", "label": "Outfit" },
          { "value": "Nunito", "label": "Nunito" }
        ],
        "default": "Inter"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "Product grid gap",
        "min": 8,
        "max": 32,
        "step": 4,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "card_border_radius",
        "label": "Card border radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "button_border_radius",
        "label": "Button border radius",
        "min": 0,
        "max": 50,
        "step": 2,
        "unit": "px",
        "default": 8
      }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_enabled",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "color",
        "id": "announcement_bg_color",
        "label": "Background color",
        "default": "#1A1A2E"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "Text color",
        "default": "#FFFFFF"
      },
      {
        "type": "text",
        "id": "announcement_text_1",
        "label": "Announcement message 1",
        "default": "🚚 شحن مجاني للطلبات فوق 200 ر.س | Free Shipping on orders over 200 SAR"
      },
      {
        "type": "text",
        "id": "announcement_text_2",
        "label": "Announcement message 2",
        "default": "💰 الدفع عند الاستلام متاح | Cash on Delivery Available"
      },
      {
        "type": "text",
        "id": "announcement_text_3",
        "label": "Announcement message 3",
        "default": "🔥 عروض حصرية يومياً | Exclusive Daily Deals"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (Arabic / main logo)"
