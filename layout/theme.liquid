<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'ar' }}" dir="{% if request.locale.iso_code == 'ar' or settings.enable_rtl %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary | default: '#006C35' }}">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Stylesheet -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- Shopify Core Header Script -->
  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  
  <!-- Announcement Bar Section -->
  {% section 'announcement-bar' %}

  <!-- Main Header Section -->
  {% section 'header' %}

  <!-- Main Content Render -->
  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- KSA Trust & Highlights Bar Section -->
  {% section 'ksa-features' %}

  <!-- Footer Section -->
  {% section 'footer' %}

  <!-- Global Snippets -->
  {% render 'cart-drawer' %}
  {% render 'quick-view-modal' %}
  
  <!-- Floating WhatsApp Support Button for KSA -->
  {% if settings.whatsapp_number != blank %}
    <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" class="whatsapp-float-btn" title="تواصل عبر واتساب">
      💬
    </a>
  {% endif %}

  <!-- Theme JavaScript -->
  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
