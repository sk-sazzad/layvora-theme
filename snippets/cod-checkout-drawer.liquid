{%- comment -%}
  Layvora Custom COD Checkout Drawer
  Renders the 2-step Cash on Delivery popup drawer for instant 1-click orders.
{%- endcomment -%}

<div class="cod-drawer" id="codDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Cash on Delivery Checkout">
  <div class="cod-drawer__overlay" id="codOverlay"></div>

  <div class="cod-drawer__panel" id="codPanel">

    <!-- Header -->
    <div class="cod-drawer__header">
      <div class="d-flex align-center gap-8">
        <span class="fs-20">💰</span>
        <div>
          <h2 class="fs-16 fw-800 m-0" style="color: var(--clr-secondary);">
            {% if request.locale.iso_code == 'ar' %}الدفع عند الاستلام{% else %}Cash on Delivery Checkout{% endif %}
          </h2>
          <span class="fs-12 text-muted">
            {% if request.locale.iso_code == 'ar' %}طلب سريع بدون بطاقة ائتمان{% else %}Fast 1-Click Order (No Credit Card Required){% endif %}
          </span>
        </div>
      </div>
      <button class="cod-drawer__close" id="codCloseBtn" aria-label="Close">✕</button>
    </div>

    <!-- Body -->
    <div class="cod-drawer__body">

      <!-- STEP 1: CUSTOMER DETAILS -->
      <div class="cod-step is-active" id="codStep1">
        <div class="cod-step-indicator mb-16">
          <span class="cod-step-badge is-active">1</span>
          <span class="fs-13 fw-600">{% if request.locale.iso_code == 'ar' %}بيانات التوصيل{% else %}Customer & Delivery Details{% endif %}</span>
        </div>

        <form id="codFormStep1" novalidate>

          <!-- 1. Full Name -->
          <div class="form-group mb-16">
            <label for="codFullName" class="form-label">
              {% if request.locale.iso_code == 'ar' %}الاسم الكامل *{% else %}Full Name *{% endif %}
            </label>
            <input
              type="text"
              id="codFullName"
              name="fullName"
              class="form-control cod-input"
              placeholder="{% if request.locale.iso_code == 'ar' %}الاسم الأول واسم العائلة{% else %}First & Last Name{% endif %}"
              required
              minlength="3"
              autocomplete="name"
            >
            <span class="cod-field-error" id="errFullName"></span>
          </div>

          <!-- 2. Phone Number -->
          <div class="form-group mb-16">
            <label for="codPhone" class="form-label">
              {% if request.locale.iso_code == 'ar' %}رقم الجوال (السعودية) *{% else %}Phone Number (KSA) *{% endif %}
            </label>
            <div class="cod-phone-wrapper">
              <span class="cod-phone-prefix">🇸🇦 +966</span>
              <input
                type="tel"
                id="codPhone"
                name="phone"
                class="form-control cod-input cod-phone-input"
                placeholder="501234567"
                required
                autocomplete="tel-national"
                dir="ltr"
              >
            </div>
            <span class="cod-field-error" id="errPhone"></span>
          </div>

          <!-- 3. City Dropdown -->
          <div class="form-group mb-16">
            <label for="codCity" class="form-label">
              {% if request.locale.iso_code == 'ar' %}المدينة *{% else %}City *{% endif %}
            </label>
            <select id="codCity" name="city" class="form-control cod-input" required>
              <option value="" disabled selected>{% if request.locale.iso_code == 'ar' %}اختر مدينتك | Select City{% else %}Select City{% endif %}</option>
              <option value="Riyadh">الرياض | Riyadh</option>
              <option value="Jeddah">جدة | Jeddah</option>
              <option value="Dammam">الدمام | Dammam</option>
              <option value="Mecca">مكة المكرمة | Mecca</option>
              <option value="Medina">المدينة المنورة | Medina</option>
              <option value="Khobar">الخبر | Khobar</option>
              <option value="Taif">الطائف | Taif</option>
              <option value="Tabuk">تبوك | Tabuk</option>
              <option value="Abha">أبها | Abha</option>
              <option value="Hail">حائل | Hail</option>
              <option value="Najran">نجران | Najran</option>
              <option value="Jizan">جازان | Jizan</option>
              <option value="Yanbu">ينبع | Yanbu</option>
              <option value="Al Qassim">القصيم | Al Qassim</option>
              <option value="Other">مدينة أخرى | Other KSA City</option>
            </select>
            <span class="cod-field-error" id="errCity"></span>
          </div>

          <!-- 4. Full Address -->
          <div class="form-group mb-16">
            <label for="codAddress" class="form-label">
              {% if request.locale.iso_code == 'ar' %}العنوان التفصيلي *{% else %}Full Detailed Address *{% endif %}
            </label>
            <textarea
              id="codAddress"
              name="address"
              class="form-control cod-input"
              rows="2"
              placeholder="{% if request.locale.iso_code == 'ar' %}اسم الحي، اسم الشارع، رقم المبنى...{% else %}District, Street name, Building number...{% endif %}"
              required
              minlength="10"
            ></textarea>
            <span class="cod-field-error" id="errAddress"></span>
          </div>

          <!-- 5. Coupon Code (Optional) -->
          <div class="form-group mb-24">
            <label for="codCoupon" class="form-label">
              {% if request.locale.iso_code == 'ar' %}كود الخصم (اختياري){% else %}Coupon Code (Optional){% endif %}
            </label>
            <div class="cod-coupon-input-group">
              <input
                type="text"
                id="codCoupon"
                name="couponCode"
                class="form-control cod-input"
                placeholder="{% if request.locale.iso_code == 'ar' %}أدخل الكود هنا...{% else %}Enter coupon code...{% endif %}"
                style="text-transform: uppercase;"
              >
              <button type="button" class="btn btn-secondary btn-sm" id="codApplyCouponBtn">
                {% if request.locale.iso_code == 'ar' %}تطبيق{% else %}Apply{% endif %}
              </button>
            </div>
            <div class="cod-coupon-message" id="codCouponMsg"></div>
          </div>

          <!-- Next Button -->
          <button type="button" class="btn btn-primary btn-lg btn-full" id="codNextStepBtn">
            <span>{% if request.locale.iso_code == 'ar' %}التالي (ملخص الطلب) ←{% else %}Next Step (Order Summary) →{% endif %}</span>
          </button>
        </form>
      </div>


      <!-- STEP 2: ORDER SUMMARY & CONFIRMATION -->
      <div class="cod-step" id="codStep2">
        <div class="cod-step-indicator mb-16">
          <button type="button" class="cod-back-btn" id="codBackBtn">
            {% if request.locale.iso_code == 'ar' %}← تعديل البيانات{% else %}← Edit Details{% endif %}
          </button>
          <span class="cod-step-badge is-active ms-auto">2</span>
          <span class="fs-13 fw-600">{% if request.locale.iso_code == 'ar' %}تأكيد الطلب{% else %}Confirm Order{% endif %}</span>
        </div>

        <!-- Selected Product / Cart Summary -->
        <div class="cod-summary-box mb-16" id="codSummaryItems">
          <!-- Populated dynamically via JavaScript -->
        </div>

        <!-- Pricing Breakdown -->
        <div class="cod-pricing-table mb-20">
          <div class="cod-pricing-row">
            <span>{% if request.locale.iso_code == 'ar' %}المجموع الفرعي{% else %}Subtotal{% endif %}</span>
            <span id="codSubtotalVal">0.00 ر.س</span>
          </div>

          <div class="cod-pricing-row">
            <span>{% if request.locale.iso_code == 'ar' %}الشحن والتوصيل{% else %}Shipping Cost{% endif %}</span>
            <span id="codShippingVal">30.00 ر.س</span>
          </div>

          <div class="cod-pricing-row cod-discount-row d-none" id="codDiscountRow">
            <span>{% if request.locale.iso_code == 'ar' %}الخصم{% else %}Discount{% endif %}</span>
            <span class="text-success" id="codDiscountVal">-0.00 ر.س</span>
          </div>

          <div class="cod-pricing-row cod-total-row">
            <span>{% if request.locale.iso_code == 'ar' %}الإجمالي النهائي{% else %}Total Amount{% endif %}</span>
            <span class="price-current fs-20" id="codTotalVal">0.00 ر.س</span>
          </div>
        </div>

        <!-- COD & Delivery Notice Box -->
        <div class="cod-notice-box mb-24">
          <div class="d-flex align-center gap-8 mb-6">
            <span>💰</span>
            <span class="fw-700 fs-13" style="color:var(--clr-success);">
              {% if request.locale.iso_code == 'ar' %}طريقة الدفع: الدفع عند الاستلام{% else %}Payment: Cash on Delivery{% endif %}
            </span>
          </div>
          <div class="fs-12 text-muted">
            📍 <span id="codSummaryCity">{% if request.locale.iso_code == 'ar' %}التوصيل إلى: الرياض{% else %}Delivery to: Riyadh{% endif %}</span> • 🚚 {% if request.locale.iso_code == 'ar' %}خلال 2-5 أيام عمل{% else %}2-5 Business Days{% endif %}
          </div>
        </div>

        <!-- Submit Button -->
        <button type="button" class="btn btn-primary btn-lg btn-full" id="codPlaceOrderBtn">
          <span id="codBtnSpinner" class="cod-spinner d-none"></span>
          <span id="codBtnText">
            {% if request.locale.iso_code == 'ar' %}تأكيد وسداد عند الاستلام ✓{% else %}Place Order (Cash on Delivery) ✓{% endif %}
          </span>
        </button>
      </div>


      <!-- STEP 3: SUCCESS STATE -->
      <div class="cod-step" id="codStepSuccess">
        <div class="cod-success-box text-center">
          <div class="cod-success-icon">✅</div>
          <h2 class="fs-22 fw-800 text-secondary mb-8">
            {% if request.locale.iso_code == 'ar' %}تم استلام طلبك بنجاح!{% else %}Order Placed Successfully!{% endif %}
          </h2>

          <div class="cod-order-number-badge mb-16" id="codSuccessOrderNo">
            #LV-1001
          </div>

          <p class="fs-14 text-muted mb-20">
            {% if request.locale.iso_code == 'ar' %}
              شكراً لثقتك في ليقورا! سيتواصل معك فريق خدمة العملاء خلال 24 ساعة لتأكيد موعد التوصيل.
            {% else %}
              Thank you for choosing Layvora! Our customer support team will contact you within 24 hours to confirm delivery.
            {% endif %}
          </p>

          <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg btn-full">
            🛍️ {% if request.locale.iso_code == 'ar' %}متابعة التسوق{% else %}Continue Shopping{% endif %}
          </a>
        </div>
      </div>


      <!-- STEP 4: ERROR STATE -->
      <div class="cod-step" id="codStepError">
        <div class="cod-error-box text-center">
          <div class="cod-error-icon">❌</div>
          <h2 class="fs-20 fw-800 text-secondary mb-8">
            {% if request.locale.iso_code == 'ar' %}حدث خطأ أثناء إرسال الطلب{% else %}Something went wrong{% endif %}
          </h2>

          <p class="fs-14 text-muted mb-20" id="codErrorMsg">
            {% if request.locale.iso_code == 'ar' %}يرجى التحقق من الاتصال والمحاولة مرة أخرى{% else %}Please check your connection and try again{% endif %}
          </p>

          <button type="button" class="btn btn-primary btn-lg btn-full" id="codRetryBtn">
            🔄 {% if request.locale.iso_code == 'ar' %}إعادة المحاولة{% else %}Try Again{% endif %}
          </button>
        </div>
      </div>

    </div>
  </div>
</div>
