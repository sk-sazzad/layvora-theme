{% comment %}
  LAYVORA THEME - Ajax Cart Drawer Snippet
{% endcomment %}

<div class="cart-drawer-overlay">
  <div class="cart-drawer" role="dialog" aria-modal="true" aria-label="سلة التسوق">
    <div class="cart-drawer-header">
      <h3>🛍️ {{ 'general.cart' | t | default: 'سلة التسوق' }} (<span class="cart-count-badge">0</span>)</h3>
      <button class="close-drawer-btn" aria-label="إغلاق السلة">✕</button>
    </div>

    <!-- Free Shipping Progress for KSA -->
    <div class="free-shipping-progress">
      <span class="free-shipping-text">أضف منتجات للحصول على شحن مجاني داخل المملكة!</span>
      <div class="progress-bar-track">
        <div class="progress-bar-fill"></div>
      </div>
    </div>

    <!-- Dynamic Cart Items Container -->
    <div class="cart-drawer-items">
      <!-- Injected via theme.js -->
    </div>

    <div class="cart-drawer-footer">
      <div class="subtotal-row">
        <span>المجموع الكلي:</span>
        <span class="cart-subtotal-val" style="color:var(--color-primary);">0.00 ر.س</span>
      </div>
      <p style="font-size:0.75rem; color:var(--color-text-muted); margin-bottom:12px;">
        * السعر شامل ضريبة القيمة المضافة 15% وتكلفة الشحن تحسب عند إتمام الطلب.
      </p>

      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/checkout" class="btn btn-primary" style="width:100%;">
          🔒 {{ 'general.checkout' | t | default: 'إتمام الطلب الآن (دفع آمن)' }}
        </a>
        <div style="display:flex; justify-content:center; gap:8px; margin-top:6px;">
          <span class="payment-icon-tag mada">مدى</span>
          <span class="payment-icon-tag tamara">تمارا</span>
          <span class="payment-icon-tag tabby">تابي</span>
          <span class="payment-icon-tag applepay">Apple Pay</span>
        </div>
      </div>
    </div>
  </div>
</div>
