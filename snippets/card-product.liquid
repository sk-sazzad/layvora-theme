{%- comment -%}
  Updated Layvora Product Card
  Renders a premium product card with badges, color swatches, rating stars, price details, and side-by-side CTA buttons.
  Accepts:
  - card_product: {Object} Product Liquid object
  - placeholder_index: {Number} Default SVG placeholder index
{%- endcomment -%}

{%- assign product = card_product -%}
{%- if product != blank -%}
  <div class="product-card" data-product-id="{{ product.id }}">
    
    <!-- Image & Badges Container -->
    <div class="product-card__img-wrap">
      <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}">
        {%- if product.featured_media != blank -%}
          <img
            src="{{ product.featured_media | image_url: width: 600 }}"
            srcset="
              {{ product.featured_media | image_url: width: 300 }} 300w,
              {{ product.featured_media | image_url: width: 450 }} 450w,
              {{ product.featured_media | image_url: width: 600 }} 600w
            "
            sizes="(max-width: 768px) 50vw, (max-width: 1200px) 33vw, 25vw"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            class="product-card__img"
            loading="lazy"
            width="300"
            height="300"
          >
        {%- else -%}
          <div class="product-card__placeholder d-flex align-center justify-center bg-light" style="width:100%; height:100%; min-height:220px;">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </a>

      <!-- Left Badge: Hot/Trending (Fire Icon) -->
      {%- if product.compare_at_price > product.price or product.tags contains 'HOT' or product.tags contains 'رائج' -%}
        <span class="product-card__badge-left" title="Hot / Trending">
          🔥 {% if request.locale.iso_code == 'ar' %}رائج{% else %}HOT{% endif %}
        </span>
      {%- endif -%}

      <!-- Right Badge: "NEW" label in Red -->
      {%- if product.tags contains 'NEW' or product.tags contains 'جديد' or product.created_at -%}
        <!-- Always show NEW badge if created recently or tagged -->
        <span class="product-card__badge-right">
          {% if request.locale.iso_code == 'ar' %}جديد{% else %}NEW{% endif %}
        </span>
      {%- endif -%}

      <!-- Top-right corner Wishlist button (♡) -->
      <button class="product-card__wishlist js-wishlist-btn" data-product-id="{{ product.id }}" aria-label="Add to Wishlist">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>
    </div>

    <!-- Variant Color Swatches -->
    {%- assign color_option = nil -%}
    {%- for option in product.options_with_values -%}
      {%- assign name_downcase = option.name | downcase -%}
      {%- if name_downcase contains 'color' or name_downcase contains 'لون' -%}
        {%- assign color_option = option -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="product-card__colors">
      {%- if color_option != blank -%}
        {%- for value in color_option.values limit: 4 -%}
          <!-- Render swatch dot using color names mapped to hex values -->
          {%- assign color_hex = value | split: ' ' | last | handle -%}
          <span class="color-swatch-dot" style="background-color: {{ color_hex }};" title="{{ value }}"></span>
        {%- endfor -%}
      {%- else -%}
        <!-- Clean dummy swatches for look-and-feel of neutral options -->
        <span class="color-swatch-dot" style="background-color: #1A1A2E;" title="Navy"></span>
        <span class="color-swatch-dot" style="background-color: #FF6B35;" title="Orange"></span>
        <span class="color-swatch-dot" style="background-color: #E2E2E2;" title="Silver"></span>
      {%- endif -%}
    </div>

    <!-- Body -->
    <div class="product-card__body">
      {%- if product.collections.first -%}
        <span class="product-card__category">{{ product.collections.first.title }}</span>
      {%- else -%}
        <span class="product-card__category">Layvora</span>
      {%- endif -%}

      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>

      <!-- Star Rating with Reviews Count -->
      <div class="product-card__rating">
        <span class="star-rating-icon">⭐</span>
        <span class="fw-700 fs-13" style="color:var(--clr-text);">5.0</span>
        <span class="rating-count" style="margin-inline-start: 2px;">
          {% if request.locale.iso_code == 'ar' %}(18 تقييم){% else %}(18 reviews){% endif %}
        </span>
      </div>

      <!-- Price -->
      <div class="product-card__price">
        <span class="price-current">{{ product.price | money_without_trailing_zeros }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="price-compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
        {%- endif -%}
      </div>
    </div>

    <!-- Bottom Actions: Side-by-side Pill Buttons -->
    <div class="product-card__actions">
      {%- if product.available -%}
        <button
          type="button"
          class="product-card__action-btn product-card__action-btn--cart js-add-to-cart"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          aria-label="Add to Cart"
        >
          {% if request.locale.iso_code == 'ar' %}سلة{% else %}Cart{% endif %}
        </button>
        <a
          href="{{ product.url }}"
          class="product-card__action-btn product-card__action-btn--buy"
          aria-label="Buy Now"
        >
          {% if request.locale.iso_code == 'ar' %}شراء{% else %}Buy Now{% endif %}
        </a>
      {%- else -%}
        <button class="product-card__action-btn product-card__action-btn--disabled btn-full" disabled style="grid-column: span 2;">
          {% if request.locale.iso_code == 'ar' %}نفذت{% else %}Sold Out{% endif %}
        </button>
      {%- endif -%}
    </div>

  </div>
{%- else -%}
  <!-- Placeholder Product Card with the new premium design -->
  <div class="product-card product-card--placeholder">
    <div class="product-card__img-wrap d-flex align-center justify-center bg-light">
      {%- assign placeholder_index = placeholder_index | default: 1 -%}
      {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
      
      <span class="product-card__badge-left">🔥 HOT</span>
      <span class="product-card__badge-right">NEW</span>
      
      <button class="product-card__wishlist" aria-label="Add to Wishlist">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>
    </div>

    <!-- Color dots -->
    <div class="product-card__colors">
      <span class="color-swatch-dot" style="background-color: #1A1A2E;"></span>
      <span class="color-swatch-dot" style="background-color: #FF6B35;"></span>
      <span class="color-swatch-dot" style="background-color: #E2E2E2;"></span>
    </div>

    <div class="product-card__body">
      <span class="product-card__category">Collection Category</span>
      <h3 class="product-card__title">Premium Store Product {{ placeholder_index }}</h3>
      
      <div class="product-card__rating">
        <span class="star-rating-icon">⭐</span>
        <span class="fw-700 fs-13">5.0</span>
        <span class="rating-count">(12 reviews)</span>
      </div>

      <div class="product-card__price">
        <span class="price-current">199 ر.س</span>
        <span class="price-compare">299 ر.س</span>
      </div>
    </div>

    <div class="product-card__actions">
      <button type="button" class="product-card__action-btn product-card__action-btn--cart">Cart</button>
      <button type="button" class="product-card__action-btn product-card__action-btn--buy">Buy Now</button>
    </div>
  </div>
{%- endif -%}
