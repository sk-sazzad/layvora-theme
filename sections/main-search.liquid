<div class="search-page section-padding" id="SearchPage">
  <div class="container">

    <!-- Search Hero -->
    <div class="search-hero rounded mb-32" style="margin-bottom:32px;">
      <h1 class="section-title text-center">
        {%- if search.performed -%}
          نتائج البحث عن: "{{ search.terms }}"
        {%- else -%}
          البحث في متجر ليقورا
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" class="search-hero__form" role="search">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="ابحث عن إلكترونيات، أزياء، مستحضرات جمال..."
          class="search-hero__input"
          aria-label="Search"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="search-hero__btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:18px;height:18px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          بحث
        </button>
      </form>
    </div>

    <!-- Results Grid -->
    {%- if search.performed -%}
      {%- paginate search.results by 16 -%}
        {%- if search.results_count > 0 -%}
          <p class="fs-14 text-muted mb-20" style="margin-bottom:20px;">
            تم العثور على {{ search.results_count }} منتج
          </p>

          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'card-product', card_product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="pagination d-flex justify-center align-center gap-12" style="margin-top: 48px;">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="btn btn-outline btn-sm">
                  ← السابق
                </a>
              {%- endif -%}
              <span class="fs-14 fw-600">{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="btn btn-primary btn-sm">
                  التالي →
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- else -%}
          <div class="no-results">
            <div class="no-results__icon">🔍</div>
            <h2 class="no-results__title">
              عذراً، لم نجد أي نتائج لـ "{{ search.terms }}"
            </h2>
            <p class="no-results__text">
              تأكد من كتابة الكلمات بشكل صحيح أو جرب كلمات بحث أخرى
            </p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg">
              🛍️ تصفح جميع المنتجات
            </a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
