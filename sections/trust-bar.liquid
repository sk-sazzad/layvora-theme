<section class="trust-bar section-padding-sm" aria-label="Trust signals">
  <div class="container">
    <div class="trust-bar__grid">

      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          <div class="trust-item__icon trust-item__icon--{{ block.settings.icon_color }}">
            {%- if block.settings.emoji != blank -%}
              {{ block.settings.emoji }}
            {%- else -%}
              {%- case block.settings.icon_type -%}
                {%- when 'delivery' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#FF6B35;"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'cod' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#27AE60;"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><circle cx="12" cy="14" r="2"/></svg>
                {%- when 'return' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#3498DB;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
                {%- when 'secure' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#FFD700;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- else -%}
                  ⭐
              {%- endcase -%}
            {%- endif -%}
          </div>
          <div class="trust-item__text">
            <p class="trust-item__title">
              {{ block.settings.title_ar }}
            </p>
            <p class="trust-item__sub">
              {{ block.settings.subtitle_ar }}
            </p>
          </div>
        </div>
      {%- else -%}

        <!-- Default trust items (Arabic-only, Premium SVGs) -->
        <div class="trust-item">
          <div class="trust-item__icon trust-item__icon--orange" style="display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#FF6B35;"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div class="trust-item__text">
            <p class="trust-item__title">توصيل سريع</p>
            <p class="trust-item__sub">خلال 2-5 أيام عمل</p>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-item__icon trust-item__icon--green" style="display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#27AE60;"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><circle cx="12" cy="14" r="2"/></svg>
          </div>
          <div class="trust-item__text">
            <p class="trust-item__title">الدفع عند الاستلام</p>
            <p class="trust-item__sub">متاح لجميع الطلبات</p>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-item__icon trust-item__icon--blue" style="display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#3498DB;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
          </div>
          <div class="trust-item__text">
            <p class="trust-item__title">إرجاع سهل</p>
            <p class="trust-item__sub">خلال 7 أيام عمل</p>
          </div>
        </div>

        <div class="trust-item">
          <div class="trust-item__icon trust-item__icon--gold" style="display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px;height:26px;color:#FFD700;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="trust-item__text">
            <p class="trust-item__title">تسوق آمن</p>
            <p class="trust-item__sub">100% مضمون ومحمي</p>
          </div>
        </div>

      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Bar",
  "class": "section-trust-bar",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Icon emoji (leave blank to use SVG)",
          "default": "🚚"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon type (if no emoji)",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "cod",      "label": "Cash on Delivery" },
            { "value": "return",   "label": "Returns" },
            { "value": "secure",   "label": "Secure" }
          ],
          "default": "delivery"
        },
        {
          "type": "select",
          "id": "icon_color",
          "label": "Icon background color",
          "options": [
            { "value": "orange", "label": "Orange" },
            { "value": "green",  "label": "Green" },
            { "value": "blue",   "label": "Blue" },
            { "value": "gold",   "label": "Gold" }
          ],
          "default": "orange"
        },
        {
          "type": "text",
          "id": "title_ar",
          "label": "Title (Arabic)",
          "default": "توصيل سريع"
        },
        {
          "type": "text",
          "id": "title_en",
          "label": "Title (English)",
          "default": "Fast Delivery"
        },
        {
          "type": "text",
          "id": "subtitle_ar",
          "label": "Subtitle (Arabic)",
          "default": "خلال 2-5 أيام"
        },
        {
          "type": "text",
          "id": "subtitle_en",
          "label": "Subtitle (English)",
          "default": "In 2-5 Days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "emoji": "🚚",
            "icon_color": "orange",
            "title_ar": "توصيل سريع",
            "title_en": "Fast Delivery",
            "subtitle_ar": "خلال 2-5 أيام",
            "subtitle_en": "In 2-5 Days"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "emoji": "💰",
            "icon_color": "green",
            "title_ar": "الدفع عند الاستلام",
            "title_en": "Cash on Delivery",
            "subtitle_ar": "متاح لجميع الطلبات",
            "subtitle_en": "Available for all orders"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "emoji": "↩️",
            "icon_color": "blue",
            "title_ar": "إرجاع سهل",
            "title_en": "Easy Returns",
            "subtitle_ar": "خلال 7 أيام",
            "subtitle_en": "Within 7 Days"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "emoji": "🔒",
            "icon_color": "gold",
            "title_ar": "تسوق آمن",
            "title_en": "Secure Shopping",
            "subtitle_ar": "100% مضمون",
            "subtitle_en": "100% Guaranteed"
          }
        }
      ]
    }
  ]
}
{% endschema %}
