<section class="bnpl-showcase-section">
  <div class="container">
    
    <div class="bnpl-banner">
      <div class="bnpl-content">
        <span class="badge badge-accent" style="margin-bottom:12px;">💳 تسوق بلا حدود</span>
        <h3 data-ar="قسم مشترياتك على 4 دفعات مريحة وبدون فوائد!" data-en="Split your payments in 4 interest-free installments!">
          قسم مشترياتك على 4 دفعات مريحة وبدون فوائد!
        </h3>
        <p data-ar="اختر تمارا أو تابي عند إتمام الدفع واستمتع باستلام طلبك فوراً ودفع قيمته على 4 أشهر بدون أي رسوم إضافية." data-en="Choose Tamara or Tabby at checkout and get your order right away while paying over 4 months with zero extra fees.">
          اختر تمارا أو تابي عند إتمام الدفع واستمتع باستلام طلبك فوراً ودفع قيمته على 4 أشهر بدون أي رسوم إضافية.
        </p>

        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <a href="/pages/bnpl-info" class="btn btn-accent">
            تعرف على كيف تعمل خدمة التقسيط
          </a>
        </div>
      </div>

      <div class="bnpl-partners">
        <div class="partner-box">
          <div style="background:#37C392; color:#fff; font-size:1.2rem; font-weight:800; padding:6px 16px; border-radius:8px;">
            tamara | تمارا
          </div>
          <span>4 دفعات شهرية مريحة</span>
        </div>

        <div class="partner-box">
          <div style="background:#3BFFC4; color:#000; font-size:1.2rem; font-weight:800; padding:6px 16px; border-radius:8px;">
            tabby | تابي
          </div>
          <span>قسمها على 4 بدون فوائد</span>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Tamara & Tabby BNPL Showcase",
  "settings": []
}
{% endschema %}
