<section class="hero-banner" id="HeroBanner" aria-label="Hero Banner">
  <div class="hero-slides-wrapper" id="heroSlides">

    {%- for block in section.blocks -%}
      <div
        class="hero-slide {% if forloop.first %}is-active{% endif %}"
        id="hero-slide-{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <!-- Background -->
        {%- if block.settings.video_url != blank -%}
          <video
            class="hero-slide__bg"
            src="{{ block.settings.video_url }}"
            autoplay muted loop playsinline
            preload="metadata"
          ></video>
        {%- elsif block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1800 }}"
            srcset="
              {{ block.settings.image | image_url: width: 800  }} 800w,
              {{ block.settings.image | image_url: width: 1200 }} 1200w,
              {{ block.settings.image | image_url: width: 1800 }} 1800w
            "
            sizes="100vw"
            alt="{{ block.settings.image.alt | default: block.settings.heading_ar }}"
            class="hero-slide__bg"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
          >
        {%- else -%}
          <div class="hero-slide__bg" style="background: linear-gradient(135deg, {{ block.settings.bg_color_start }}, {{ block.settings.bg_color_end }});"></div>
        {%- endif -%}

        <!-- Overlay -->
        <div class="hero-slide__overlay" style="background: {{ block.settings.overlay_color }};"></div>

        <!-- Content -->
        <div class="container">
          <div class="hero-slide__content">

            {%- if request.locale.iso_code == 'ar' -%}
              {%- if block.settings.badge_ar != blank -%}
                <span class="hero-badge">{{ block.settings.badge_ar }}</span>
              {%- endif -%}
              {%- if block.settings.heading_ar != blank -%}
                <h2 class="hero-title">{{ block.settings.heading_ar }}</h2>
              {%- endif -%}
              {%- if block.settings.subtitle_ar != blank -%}
                <p class="hero-subtitle">{{ block.settings.subtitle_ar }}</p>
              {%- endif -%}
            {%- else -%}
              {%- if block.settings.badge_en != blank -%}
                <span class="hero-badge">{{ block.settings.badge_en }}</span>
              {%- endif -%}
              {%- if block.settings.heading_en != blank -%}
                <h2 class="hero-title">{{ block.settings.heading_en }}</h2>
              {%- endif -%}
              {%- if block.settings.subtitle_en != blank -%}
                <p class="hero-subtitle">{{ block.settings.subtitle_en }}</p>
              {%- endif -%}
            {%- endif -%}

            <div class="hero-actions">
              {%- if request.locale.iso_code == 'ar' -%}
                {%- if block.settings.btn1_text_ar != blank -%}
                  <a href="{{ block.settings.btn1_url | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg" id="hero-btn1-{{ forloop.index }}">
                    {{ block.settings.btn1_text_ar }}
                  </a>
                {%- endif -%}
                {%- if block.settings.btn2_text_ar != blank -%}
                  <a href="{{ block.settings.btn2_url | default: '/collections/deals' }}" class="btn btn-outline-white btn-lg" id="hero-btn2-{{ forloop.index }}">
                    {{ block.settings.btn2_text_ar }}
                  </a>
                {%- endif -%}
              {%- else -%}
                {%- if block.settings.btn1_text_en != blank -%}
                  <a href="{{ block.settings.btn1_url | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg" id="hero-btn1-{{ forloop.index }}">
                    {{ block.settings.btn1_text_en }}
                  </a>
                {%- endif -%}
                {%- if block.settings.btn2_text_en != blank -%}
                  <a href="{{ block.settings.btn2_url | default: '/collections/deals' }}" class="btn btn-outline-white btn-lg" id="hero-btn2-{{ forloop.index }}">
                    {{ block.settings.btn2_text_en }}
                  </a>
                {%- endif -%}
              {%- endif -%}
            </div>

          </div>
        </div>
      </div>
    {%- else -%}

      <!-- Default slide when no blocks configured -->
      <div class="hero-slide is-active">
        <div class="hero-slide__bg" style="background: linear-gradient(135deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%);"></div>
        <div class="hero-slide__overlay" style="background: rgba(0,0,0,0.2);"></div>
        <div class="container">
          <div class="hero-slide__content">
            {%- if request.locale.iso_code == 'ar' -%}
              <span class="hero-badge">🔥 العروض الحصرية</span>
              <h1 class="hero-title">تسوق بأفضل الأسعار</h1>
              <p class="hero-subtitle">منتجات أصيلة بأسعار تنافسية في المملكة العربية السعودية</p>
            {%- else -%}
              <span class="hero-badge">🔥 Exclusive Deals</span>
              <h1 class="hero-title">Shop the Best Deals</h1>
              <p class="hero-subtitle">Authentic products at competitive prices in Saudi Arabia</p>
            {%- endif -%}
            <div class="hero-actions">
              <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg" id="hero-default-btn1">
                {% if request.locale.iso_code == 'ar' %}تسوق الآن{% else %}Shop Now{% endif %}
              </a>
              <a href="/collections/deals" class="btn btn-outline-white btn-lg" id="hero-default-btn2">
                {% if request.locale.iso_code == 'ar' %}عروض اليوم{% else %}Today's Deals{% endif %}
              </a>
            </div>
          </div>
        </div>
      </div>

    {%- endfor -%}
  </div>

  <!-- Navigation dots -->
  {%- if section.blocks.size > 1 -%}
    <div class="hero-dots" role="tablist" aria-label="Hero slides">
      {%- for block in section.blocks -%}
        <button
          class="hero-dot {% if forloop.first %}is-active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="Slide {{ forloop.index }}"
          id="hero-dot-{{ forloop.index0 }}"
        ></button>
      {%- endfor -%}
    </div>

    <!-- Arrows -->
    <button class="hero-arrow hero-arrow--prev" id="heroPrev" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <button class="hero-arrow hero-arrow--next" id="heroNext" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
  {%- endif -%}
</section>

<style>
  #HeroBanner {
    min-height: {{ section.settings.min_height }}px;
  }
  .hero-slides-wrapper {
    position: relative;
    min-height: inherit;
  }
  .hero-slide {
    min-height: {{ section.settings.min_height }}px;
  }
  .hero-slide__content {
    padding-block: 60px;
  }
  @media (max-width: 768px) {
    #HeroBanner, .hero-slide {
      min-height: {{ section.settings.min_height | times: 0.6 | round }}px;
    }
  }
</style>

<script>
  (function() {
    var slides = document.querySelectorAll('#HeroBanner .hero-slide');
    var dots   = document.querySelectorAll('#HeroBanner .hero-dot');
    var prev   = document.getElementById('heroPrev');
    var next   = document.getElementById('heroNext');
    var current = 0;
    var autoplayInterval;
    var autoplayDelay = {{ section.settings.autoplay_speed | times: 1000 | default: 5000 }};

    if (slides.length <= 1) return;

    function goTo(index) {
      slides[current].classList.remove('is-active');
      if (dots[current]) { dots[current].classList.remove('is-active'); dots[current].setAttribute('aria-selected', 'false'); }
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      if (dots[current]) { dots[current].classList.add('is-active'); dots[current].setAttribute('aria-selected', 'true'); }
    }

    function startAutoplay() {
      if (!{{ section.settings.autoplay | json }}) return;
      autoplayInterval = setInterval(function() { goTo(current + 1); }, autoplayDelay);
    }

    function stopAutoplay() {
      clearInterval(autoplayInterval);
    }

    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() { stopAutoplay(); goTo(i); startAutoplay(); });
    });

    if (prev) prev.addEventListener('click', function() { stopAutoplay(); goTo(current - 1); startAutoplay(); });
    if (next) next.addEventListener('click', function() { stopAutoplay(); goTo(current + 1); startAutoplay(); });

    // Touch/swipe support
    var touchStartX = 0;
    var heroEl = document.getElementById('HeroBanner');
    if (heroEl) {
      heroEl.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
      heroEl.addEventListener('touchend', function(e) {
        var delta = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(delta) > 50) {
          stopAutoplay();
          goTo(delta > 0 ? current - 1 : current + 1);
          startAutoplay();
        }
      }, { passive: true });
    }

    startAutoplay();
  })();
</script>

