<section class="hero-section">
  <div class="container">
    <div class="hero-grid">
      
      <!-- Text Banner Side -->
      <div class="hero-banner-card">
        <div class="hero-content">
          <span class="hero-subtitle">
            🇸🇦 تشكيلة الموسم الحصرية 2026
          </span>
          <h1 class="hero-title">
            تسوق أفضل المنتجات العالمية بملمس <span class="highlight">فخم وأنيق</span>
          </h1>
          <p class="hero-desc" data-ar="استمتع بتجربة تسوق فريدة تشمل التوصيل السريع لجميع مناطق المملكة مع خيارات التقسيط المريح عبر تمارا وتابي." data-en="Enjoy an extraordinary shopping experience with fast delivery across KSA & flexible installments.">
            استمتع بتجربة تسوق فريدة تشمل التوصيل السريع لجميع مناطق المملكة مع خيارات التقسيط المريح عبر تمارا وتابي.
          </p>
          
          <div class="hero-cta">
            <a href="/collections/all" class="btn btn-primary">
              🛍️ تسوق عروض اليوم
            </a>
            <a href="/pages/tamara-bnpl" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4); color:#fff;">
              💳 ادفع بالتقسيط (تمارا/تابي)
            </a>
          </div>
        </div>
      </div>

      <!-- Image Visual Side -->
      <div class="hero-visual">
        <div class="hero-image-wrap">
          <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=800&q=80" alt="Layvora Modern Saudi Collection" class="hero-image">
        </div>

        <!-- Floating KSA Perk Cards -->
        <div class="floating-card floating-card-1">
          <div class="floating-icon">🚚</div>
          <div class="floating-text">
            <div class="title">توصيل سريع للرياض وباقي المدن</div>
            <div class="sub">خلال 24 - 48 ساعة فقط</div>
          </div>
        </div>

        <div class="floating-card floating-card-2">
          <div class="floating-icon">✨</div>
          <div class="floating-text">
            <div class="title">ضمان أصلية 100%</div>
            <div class="sub">منتجات موثوقة ومفحوصة</div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Slider",
  "settings": []
}
{% endschema %}
