          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="103" data-title="سماعات لافورا اللاسلكية" data-price="249" data-image="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

      <!-- Product 4 -->
      <div class="product-card">
        <div class="product-badge-stack">
          <span class="badge badge-coral">خصم 25% ⚡</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80" class="product-image" alt="مجموعة العناية الفاخرة">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="104" data-title="مجموعة العناية الطبيعية بالبشرة - سيروم وكريم" data-price="180" data-orig-price="240" data-image="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80" data-category="عناية" data-desc="مجموعة متكاملة ترطب البشرة وتمنحها نضارة وإشراقة طبيعية بمكونات عضوية 100%.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">جمال وعناية</span>
          <h3 class="product-title">مجموعة العناية الطبيعية بالبشرة</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(95 تقييم)</span></div>
          <div class="product-price-row">
            <span class="price-current">180 <span class="price-currency">ر.س</span></span>
            <span class="price-original">240 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>45.00 ر.س</strong></span>
            <span class="tabby-tag">تابي</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="104" data-title="مجموعة العناية بالبشرة" data-price="180" data-image="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

    </div>

  </div>
</section>

