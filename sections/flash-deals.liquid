<section class="flash-deals-section">
  <div class="container">
    
    <div class="flash-header">
      <div class="section-title-wrap">
        <h2 style="color:var(--color-coral); display:flex; align-items:center; gap:8px;">
          ⚡ عروض الفلاش اليومية - خصومات حتى 60%
        </h2>
        <p>ينتهي العرض قريباً، سارع بالحصول على الكمية المحدودة!</p>
      </div>

      <div class="countdown-box">
        <span style="font-weight:700; font-size:0.85rem; color:var(--color-coral);">ينتهي خلال:</span>
        <span class="timer-unit timer-h">14</span>
        <span class="timer-colon">:</span>
        <span class="timer-unit timer-m">32</span>
        <span class="timer-colon">:</span>
        <span class="timer-unit timer-s">45</span>
      </div>
    </div>

    <div class="products-grid">
      
      <!-- Product 1 -->
      <div class="product-card">
        <div class="product-badge-stack">
          <span class="badge badge-coral">خصم 40% ⚡</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80" class="product-image" alt="عطر العود الملكي">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="101" data-title="عطر العود الملكي المعتّق - 100 مل" data-price="299" data-orig-price="499" data-image="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80" data-category="عطور" data-desc="عطر فخم يجمع بين دهن العود الكلمنتان والورد الطائفي الأصيل، ليعكس أصالة التراث السعودي بلمسة عصرية.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">عطور فاخرة</span>
          <h3 class="product-title">عطر العود الملكي المعتّق - 100 مل</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(124 تقييم)</span></div>
          <div class="product-price-row">
            <span class="price-current">299 <span class="price-currency">ر.س</span></span>
            <span class="price-original">499 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>74.75 ر.س</strong></span>
            <span class="tamara-tag">تمارا</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="101" data-title="عطر العود الملكي المعتّق - 100 مل" data-price="299" data-image="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

      <!-- Product 2 -->
      <div class="product-card">
        <div class="product-badge-stack">
          <span class="badge badge-coral">خصم 35% ⚡</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=400&q=80" class="product-image" alt="ساعة كلاسيكية فاخرة">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="102" data-title="ساعة لافورا أكتيف الذكية المقاومة للماء" data-price="195" data-orig-price="300" data-image="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=400&q=80" data-category="ساعات" data-desc="ساعة أنيقة تدعم تتبع الأنشطة الرياضية وقياس معدل نبضات القلب مع بطارية تدوم حتى 10 أيام.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">ساعات وأجهزة</span>
          <h3 class="product-title">ساعة لافورا أكتيف الذكية المقاومة للماء</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(89 تقييم)</span></div>
          <div class="product-price-row">
            <span class="price-current">195 <span class="price-currency">ر.س</span></span>
            <span class="price-original">300 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>48.75 ر.س</strong></span>
            <span class="tabby-tag">تابي</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="102" data-title="ساعة لافورا أكتيف الذكية" data-price="195" data-image="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

      <!-- Product 3 -->
      <div class="product-card">
        <div class="product-badge-stack">
          <span class="badge badge-coral">خصم 50% ⚡</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80" class="product-image" alt="سماعات لاسلكية">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="103" data-title="سماعات لافورا اللاسلكية بنظام العزل الفائق" data-price="249" data-orig-price="499" data-image="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=400&q=80" data-category="إلكترونيات" data-desc="صوت نقي بتقنية العزل النشط للضوضاء وتصميم مريح للأذن للاستخدام الطويل.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">إلكترونيات</span>
          <h3 class="product-title">سماعات لافورا اللاسلكية بنظام العزل</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(210 تقييم)</span></div>
          <div class="product-price-row">
            <span class="price-current">249 <span class="price-currency">ر.س</span></span>
            <span class="price-original">499 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>62.25 ر.س</strong></span>
