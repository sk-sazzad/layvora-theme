    <div class="trust-grid">
      
      <div class="trust-card">
        <div class="trust-icon">🚚</div>
        <div class="trust-info">
          <h4 data-ar="توصيل سريع لجميع المدن" data-en="Fast KSA Delivery">توصيل سريع لجميع المدن</h4>
