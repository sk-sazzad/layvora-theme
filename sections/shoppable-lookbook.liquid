<section class="shoppable-lookbook-section" style="padding: 60px 0;">
  <div class="container">
    
    <div class="section-header" style="text-align: center; margin-bottom: 40px;">
      <span class="badge badge-accent" style="margin-bottom: 10px;">✨ إطلالات وتنسيقات حصرية</span>
      <h2>تنسيقات الموسم الفاخرة 2026</h2>
      <p>استكشف التشكيلات المتناسقة وانقر على المنتجات للتسوق المباشر</p>
    </div>

    <div class="lookbook-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: center;">
      
      <!-- Banner 1: Oud & Perfume Luxe -->
      <div class="lookbook-card" style="position: relative; border-radius: var(--radius-lg); overflow: hidden; height: 420px; box-shadow: var(--shadow-lg);">
        <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=800&q=80" style="width: 100%; height: 100%; object-fit: cover;" alt="ركن العطور">
        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,23,42,0.85) 0%, rgba(0,0,0,0.2) 60%);"></div>
        <div style="position: absolute; bottom: 30px; left: 30px; right: 30px; color: var(--color-white);">
          <span class="badge badge-gold" style="margin-bottom: 10px;">مجموعة الأصالة 🌙</span>
          <h3 style="font-size: 1.6rem; font-weight: 800; margin-bottom: 8px;">مجموعة العود الملكي والورد الطائفي</h3>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.85); margin-bottom: 18px;">تركيبات عطرية نادرة بثبات يدوم لأكثر من 24 ساعة.</p>
          <a href="/collections/perfumes" class="btn btn-primary btn-sm">تسوق المجموعة الفاخرة ←</a>
        </div>
      </div>

      <!-- Banner 2: Fashion & Watches -->
      <div class="lookbook-card" style="position: relative; border-radius: var(--radius-lg); overflow: hidden; height: 420px; box-shadow: var(--shadow-lg);">
        <img src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=800&q=80" style="width: 100%; height: 100%; object-fit: cover;" alt="الساعات والملحقات">
        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(123,44,191,0.85) 0%, rgba(0,0,0,0.2) 60%);"></div>
        <div style="position: absolute; bottom: 30px; left: 30px; right: 30px; color: var(--color-white);">
          <span class="badge badge-coral" style="margin-bottom: 10px;">إناقة لا تضاهى ⚡</span>
          <h3 style="font-size: 1.6rem; font-weight: 800; margin-bottom: 8px;">الساعات والأكسسوارات الفاخرة</h3>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.85); margin-bottom: 18px;">تصاميم عصرية مميزة تناسب اجتماعاتك وإطلالاتك اليومية.</p>
          <a href="/collections/watches" class="btn btn-accent btn-sm">استكشف التشكيلة الجديدة ←</a>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shoppable Lookbook",
  "settings": []
}
{% endschema %}
