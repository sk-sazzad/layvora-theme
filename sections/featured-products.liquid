<section class="featured-products-section" style="padding: 50px 0;">
  <div class="container">
    
    <div class="section-header">
      <div class="section-title-wrap">
        <h2 data-ar="أحدث المنتجات المختارة لك" data-en="Featured Products For You">أحدث المنتجات المختارة لك</h2>
        <p data-ar="منتجات متميزة تتماشى مع أعلى درجات الفخامة والأناقة" data-en="Handpicked luxury items for modern lifestyle">منتجات متميزة تتماشى مع أعلى درجات الفخامة والأناقة</p>
      </div>
      <a href="/collections/all" class="btn btn-outline btn-sm">استكشف المزيد ←</a>
    </div>

    <div class="products-grid">
      
      <!-- Product Card Snippet Loop -->
      <div class="product-card">
        <div class="product-badge-stack">
          <span class="badge badge-gold">الأكثر مبيعاً ⚡</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80" class="product-image" alt="عطر السمو الملكي">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="201" data-title="عطر السمو الملكي - عود وورد طائفي" data-price="350" data-image="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80" data-category="عطور" data-desc="عطر شرقي فاخر يناسب لكافة المناسبات الرسمية والأعياد.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">عطور فاخرة</span>
          <h3 class="product-title">عطر السمو الملكي - عود وورد طائفي</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(98)</span></div>
          <div class="product-price-row">
            <span class="price-current">350 <span class="price-currency">ر.س</span></span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>87.50 ر.س</strong></span>
            <span class="tamara-tag">تمارا</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="201" data-title="عطر السمو الملكي" data-price="350" data-image="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": []
}
{% endschema %}
