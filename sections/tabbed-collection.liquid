<section class="tabbed-collection-section" style="padding: 60px 0; background: var(--color-bg-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container">
    
    <div class="section-header" style="flex-direction: column; align-items: center; text-align: center; margin-bottom: 30px;">
      <span class="badge badge-primary" style="margin-bottom: 10px;">🛍️ تصفح حسب اختيارك</span>
      <h2>المجموعات الأكثر طلباً في السعودية</h2>
      <p>تنقل بسلاسة بين الأقسام واكتشف المنتجات المميزة بأسعار استثنائية</p>

      <!-- Category Filter Pills -->
      <div class="category-tabs" style="display: flex; align-items: center; gap: 12px; margin-top: 24px; flex-wrap: wrap; justify-content: center;">
        <button class="tab-pill active" data-category="all">الكل ✨</button>
        <button class="tab-pill" data-category="perfumes">العطور والبخور 🌙</button>
        <button class="tab-pill" data-category="fashion">الأزياء الفاخرة</button>
        <button class="tab-pill" data-category="watches">الساعات الذكية</button>
        <button class="tab-pill" data-category="beauty">العناية والجمال</button>
      </div>
    </div>

    <!-- Filterable Product Grid -->
    <div class="products-grid tabbed-products-grid">
      
      <!-- Product 1: Perfumes -->
      <div class="product-card" data-cat="perfumes">
        <div class="product-badge-stack">
          <span class="badge badge-gold">الأكثر طلباً ⚡</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80" class="product-image" alt="عطر العود الكلمنتان">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="301" data-title="دهن العود الكلمنتان الفاخر 1/4 تولة" data-price="450" data-orig-price="650" data-image="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80" data-category="عطور" data-desc="عود طبيعي 100% معتق لأكثر من 5 سنوات برائحة بخورية مميزة وفوّاحة.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">عطور وبخور</span>
          <h3 class="product-title">دهن العود الكلمنتان الفاخر 1/4 تولة</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(142)</span></div>
          <div class="product-price-row">
            <span class="price-current">450 <span class="price-currency">ر.س</span></span>
            <span class="price-original">650 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>112.50 ر.س</strong></span>
            <span class="tamara-tag">تمارا</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="301" data-title="دهن العود الكلمنتان الفاخر" data-price="450" data-image="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

      <!-- Product 2: Fashion -->
      <div class="product-card" data-cat="fashion">
        <div class="product-badge-stack">
          <span class="badge badge-accent">تشكيلة جديدة</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=400&q=80" class="product-image" alt="عباية مطرزة">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="302" data-title="عباية حريرية سوداء بقصّة ملكية مطرزة" data-price="380" data-orig-price="500" data-image="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=400&q=80" data-category="أزياء" data-desc="تصميم سعودي عصري وقماش حرير أسود فاخر مع طرحة مجانية مطابقة.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">أزياء فاخرة</span>
          <h3 class="product-title">عباية حريرية سوداء بقصّة ملكية مطرزة</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(76)</span></div>
          <div class="product-price-row">
            <span class="price-current">380 <span class="price-currency">ر.س</span></span>
            <span class="price-original">500 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>95.00 ر.س</strong></span>
            <span class="tabby-tag">تابي</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="302" data-title="عباية حريرية سوداء" data-price="380" data-image="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

      <!-- Product 3: Watches -->
      <div class="product-card" data-cat="watches">
        <div class="product-badge-stack">
          <span class="badge badge-coral">خصم 30%</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=400&q=80" class="product-image" alt="ساعة كلاسيكية">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="303" data-title="ساعة لافورا كرونوغراف بسوار استيل ذهبي" data-price="420" data-orig-price="600" data-image="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=400&q=80" data-category="ساعات" data-desc="ساعة رسمية ذات تصميم سويسري فاخر وهيكل مقاوم للماء ومضاد للخدش.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">ساعات مجوهرات</span>
          <h3 class="product-title">ساعة لافورا كرونوغراف بسوار استيل ذهبي</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(88)</span></div>
          <div class="product-price-row">
            <span class="price-current">420 <span class="price-currency">ر.س</span></span>
            <span class="price-original">600 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>105.00 ر.س</strong></span>
            <span class="tamara-tag">تمارا</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="303" data-title="ساعة لافورا كرونوغراف" data-price="420" data-image="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

      <!-- Product 4: Beauty -->
      <div class="product-card" data-cat="beauty">
        <div class="product-badge-stack">
          <span class="badge badge-primary">الأكثر تقييماً</span>
        </div>
        <button class="wishlist-btn">♥</button>
        <div class="product-media">
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80" class="product-image" alt="زيت الهيالورونيك">
          <div class="product-quick-actions">
            <button class="quick-view-btn" data-id="304" data-title="سيروم الهيالورونيك وفيتامين C المركز" data-price="160" data-orig-price="220" data-image="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80" data-category="عناية" data-desc="مغذي ومجدد للبشرة يقلل من التجاعيد ويمنح نضارة فائقة من الاستخدام الأول.">👁️ نظرة سريعة</button>
          </div>
        </div>
        <div class="product-details">
          <span class="product-category">العناية بالبشرة</span>
          <h3 class="product-title">سيروم الهيالورونيك وفيتامين C المركز</h3>
          <div class="product-rating">★★★★★ <span class="rating-count">(165)</span></div>
          <div class="product-price-row">
            <span class="price-current">160 <span class="price-currency">ر.س</span></span>
            <span class="price-original">220 ر.س</span>
          </div>
          <div class="bnpl-badge-wrap">
            <span>أو 4 دفعات بقيمة <strong>40.00 ر.س</strong></span>
            <span class="tabby-tag">تابي</span>
          </div>
          <button class="btn btn-primary btn-sm add-to-cart-btn" data-id="304" data-title="سيروم الهيالورونيك" data-price="160" data-image="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80">🛒 إضافة إلى السلة</button>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Tabbed Collection Switcher",
  "settings": []
}
{% endschema %}
