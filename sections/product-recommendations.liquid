<section class="product-recommendations-section" style="padding: 50px 0; background: var(--color-bg-surface); border-top: 1px solid var(--color-border);">
  <div class="container">
    
    <div class="section-header" style="margin-bottom: 30px;">
      <div class="section-title-wrap">
        <h2>منتجات يُنصح بشرائها معاً (عروض التوفير 💥)</h2>
        <p>اشترِ المجموعة المتكاملة واصل على خصم إضافي 15%</p>
      </div>
    </div>

    <!-- Frequently Bought Together Bundle -->
    <div style="background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 30px; display: grid; grid-template-columns: 2fr 1fr; gap: 30px; align-items: center; box-shadow: var(--shadow-sm);">
      
      <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
        <!-- Item 1 -->
        <div style="text-align: center; max-width: 140px;">
          <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=200&q=80" style="width: 100px; height: 100px; object-fit: cover; border-radius: 12px; border: 1px solid var(--color-border);">
          <div style="font-size: 0.82rem; font-weight: 700; margin-top: 6px;">عطر العود الملكي</div>
          <div style="color: var(--color-primary); font-weight: 800; font-size: 0.9rem;">299 ر.س</div>
        </div>

        <span style="font-size: 1.5rem; font-weight: 900; color: var(--color-text-muted);">+</span>

        <!-- Item 2 -->
        <div style="text-align: center; max-width: 140px;">
          <img src="https://images.unsplash.com/photo-1547887537-6158d64c35b3?auto=format&fit=crop&w=200&q=80" style="width: 100px; height: 100px; object-fit: cover; border-radius: 12px; border: 1px solid var(--color-border);">
          <div style="font-size: 0.82rem; font-weight: 700; margin-top: 6px;">معطر الجو والبخور</div>
          <div style="color: var(--color-primary); font-weight: 800; font-size: 0.9rem;">95 ر.س</div>
        </div>

        <span style="font-size: 1.5rem; font-weight: 900; color: var(--color-text-muted);">+</span>

        <!-- Item 3 -->
        <div style="text-align: center; max-width: 140px;">
          <img src="https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=200&q=80" style="width: 100px; height: 100px; object-fit: cover; border-radius: 12px; border: 1px solid var(--color-border);">
          <div style="font-size: 0.82rem; font-weight: 700; margin-top: 6px;">زجاجة تعبئة سفر صغيرة</div>
          <div style="color: var(--color-primary); font-weight: 800; font-size: 0.9rem;">45 ر.س</div>
        </div>
      </div>

      <!-- Bundle Total & Checkout -->
      <div style="border-inline-start: 1px solid var(--color-border); padding-inline-start: 30px; display: flex; flex-direction: column; gap: 10px;">
        <span class="badge badge-coral" style="align-self: flex-start;">وفر 65 ر.س مع الباقة!</span>
        <div style="font-size: 0.9rem; color: var(--color-text-muted);">سعر المجموعة كاملة:</div>
        <div style="font-size: 1.8rem; font-weight: 900; color: var(--color-primary);">
          374 <span style="font-size: 1rem;">ر.س</span>
          <span style="font-size: 0.9rem; color: var(--color-text-light); text-decoration: line-through; margin-inline-start: 8px;">439 ر.س</span>
        </div>
        <button class="btn btn-primary" style="width: 100%; margin-top: 8px;" onclick="alert('تمت إضافة الباقة المتكاملة للسلة بخصم 15%!')">
          🛒 إضافة المجموعة كاملة بنقرة واحدة
        </button>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Recommendations",
  "settings": []
}
{% endschema %}
