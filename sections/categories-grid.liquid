<section class="categories-section">
  <div class="container">
    
    <div class="section-header">
      <div class="section-title-wrap">
        <h2 data-ar="تسوق حسب الفئة المميزة" data-en="Shop Top Categories">تسوق حسب الفئة المميزة</h2>
        <p data-ar="اختر القسم المفضل واستكشف أفضل العروض" data-en="Explore top offers per category">اختر القسم المفضل واستكشف أفضل العروض</p>
      </div>
      <a href="/collections/all" class="btn btn-outline btn-sm">عرض الكل ←</a>
    </div>

    <div class="categories-grid">
      
      <div class="category-card" onclick="window.location.href='/collections/perfumes'">
        <div class="category-thumb">
          <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=150&q=80" alt="العطور والبخور">
        </div>
        <div class="category-name">العطور والبخور 🌙</div>
        <div class="category-count">128 منتج</div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/fashion'">
        <div class="category-thumb">
          <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=150&q=80" alt="الأزياء الفاخرة">
        </div>
        <div class="category-name">الأزياء الفاخرة</div>
        <div class="category-count">240 منتج</div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/beauty'">
        <div class="category-thumb">
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=150&q=80" alt="العناية بالبشرة">
        </div>
        <div class="category-name">العناية والجمال</div>
        <div class="category-count">94 منتج</div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/electronics'">
        <div class="category-thumb">
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=150&q=80" alt="سماعات وأجهزة">
        </div>
        <div class="category-name">الأجهزة والإلكترونيات</div>
        <div class="category-count">85 منتج</div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/watches'">
        <div class="category-thumb">
          <img src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=150&q=80" alt="الساعات والمجوهرات">
        </div>
        <div class="category-name">الساعات الفاخرة</div>
        <div class="category-count">62 منتج</div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/home'">
        <div class="category-thumb">
          <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=150&q=80" alt="مستلزمات المنزل">
        </div>
        <div class="category-name">ديكور ومستلزمات</div>
        <div class="category-count">110 منتج</div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Categories Grid",
  "settings": []
}
{% endschema %}
