<section class="section-padding {% if section.settings.bg_style == 'light' %}bg-light{% else %}bg-white{% endif %}" aria-label="Categories">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="title-ar">{{ section.settings.title_ar | default: 'تسوق حسب الفئة' }}</span>
        <span class="title-en">{{ section.settings.title_en | default: 'Shop by Category' }}</span>
        <span class="accent-line"></span>
      </h2>
    </div>

    <div class="categories-grid" id="categoriesGrid">

      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="category-card"
          id="cat-{{ forloop.index }}"
          {{ block.shopify_attributes }}
          aria-label="{{ block.settings.name_ar }} {{ block.settings.name_en }}"
        >
          <div class="category-card__icon">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 128 }}"
                alt="{{ block.settings.name_ar }}"
                class="category-card__img"
                loading="lazy"
                width="64"
                height="64"
              >
            {%- else -%}
              {{ block.settings.emoji | default: '🛍️' }}
            {%- endif -%}
          </div>
          <div class="category-card__name">
            <span class="category-card__name-ar">{{ block.settings.name_ar }}</span>
            <span class="category-card__name-en">{{ block.settings.name_en }}</span>
          </div>
        </a>
      {%- else -%}

        <!-- Default categories -->
        <a href="/collections/electronics" class="category-card" id="cat-electronics">
          <div class="category-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:28px;height:28px;color:var(--clr-secondary);"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <div class="category-card__name">
            <span class="category-card__name-ar">إلكترونيات</span>
            <span class="category-card__name-en">Electronics</span>
          </div>
        </a>

        <a href="/collections/fashion" class="category-card" id="cat-fashion">
          <div class="category-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:28px;height:28px;color:var(--clr-secondary);"><path d="M20.37 4.65a2 2 0 0 0-1.89-1.34H5.52a2 2 0 0 0-1.89 1.34L2 11h20zM2 11l3 10h14l3-10z"/></svg>
          </div>
          <div class="category-card__name">
            <span class="category-card__name-ar">أزياء</span>
            <span class="category-card__name-en">Fashion</span>
          </div>
        </a>

        <a href="/collections/beauty" class="category-card" id="cat-beauty">
          <div class="category-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:28px;height:28px;color:var(--clr-secondary);"><path d="M19 2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM12 18a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/></svg>
          </div>
          <div class="category-card__name">
            <span class="category-card__name-ar">جمال وعناية</span>
            <span class="category-card__name-en">Beauty</span>
          </div>
        </a>

        <a href="/collections/home-kitchen" class="category-card" id="cat-home">
          <div class="category-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:28px;height:28px;color:var(--clr-secondary);"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <div class="category-card__name">
            <span class="category-card__name-ar">المنزل والمطبخ</span>
            <span class="category-card__name-en">Home & Kitchen</span>
          </div>
        </a>

        <a href="/collections/accessories" class="category-card" id="cat-accessories">
          <div class="category-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:28px;height:28px;color:var(--clr-secondary);"><circle cx="12" cy="12" r="7"/><polyline points="12 9 12 12 13.5 13.5"/></svg>
          </div>
          <div class="category-card__name">
            <span class="category-card__name-ar">إكسسوارات</span>
            <span class="category-card__name-en">Accessories</span>
          </div>
        </a>

        <a href="/collections/deals" class="category-card" id="cat-deals" style="border-color: var(--clr-primary);">
          <div class="category-card__icon" style="background: rgba(255,107,53,0.1);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:28px;height:28px;color:var(--clr-primary);"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <div class="category-card__name">
            <span class="category-card__name-ar">عروض وتخفيضات</span>
            <span class="category-card__name-en">Deals</span>
          </div>
        </a>

      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categories Grid",
  "class": "section-categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title_ar",
      "label": "Title (Arabic)",
      "default": "تسوق حسب الفئة"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Title (English)",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "bg_style",
      "label": "Section background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light warm" }
      ],
      "default": "light"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji icon (if no image)",
          "default": "📱"
        },
        {
          "type": "text",
          "id": "name_ar",
          "label": "Name (Arabic)",
          "default": "إلكترونيات"
        },
        {
          "type": "text",
          "id": "name_en",
          "label": "Name (English)",
          "default": "Electronics"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories Grid",
      "blocks": [
        { "type": "category", "settings": { "emoji": "📱", "name_ar": "إلكترونيات", "name_en": "Electronics" } },
        { "type": "category", "settings": { "emoji": "👗", "name_ar": "أزياء", "name_en": "Fashion" } },
        { "type": "category", "settings": { "emoji": "💄", "name_ar": "جمال وعناية", "name_en": "Beauty" } },
        { "type": "category", "settings": { "emoji": "🏡", "name_ar": "المنزل والمطبخ", "name_en": "Home & Kitchen" } },
        { "type": "category", "settings": { "emoji": "⌚", "name_ar": "إكسسوارات", "name_en": "Accessories" } },
        { "type": "category", "settings": { "emoji": "🔥", "name_ar": "عروض وتخفيضات", "name_en": "Deals" } }
      ]
    }
  ]
}
{% endschema %}
