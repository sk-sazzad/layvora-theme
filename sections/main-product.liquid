<section class="main-product-section" style="padding: 40px 0 60px;">
  <div class="container">
    
    <!-- Breadcrumb -->
    <div class="breadcrumb" style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
      <a href="/" style="color: var(--color-text-muted);">الرئيسية</a>
      <span>/</span>
      <a href="/collections/perfumes" style="color: var(--color-text-muted);">العطور والبخور</a>
      <span>/</span>
      <span style="color: var(--color-text-main); font-weight: 600;">عطر العود الملكي المعتّق - 100 مل</span>
    </div>

    <!-- Product Layout Grid -->
    <div class="product-layout-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: start;">
      
      <!-- Left Column: Gallery & Thumbnails -->
      <div class="product-gallery-wrap">
        <div class="main-image-frame" style="position: relative; border-radius: var(--radius-lg); overflow: hidden; background: var(--color-bg-secondary); border: 1px solid var(--color-border); aspect-ratio: 1; box-shadow: var(--shadow-md);">
          <img id="main-product-img" src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=800&q=80" alt="عطر العود الملكي" style="width: 100%; height: 100%; object-fit: cover; transition: opacity 0.3s ease;">
          
          <span class="badge badge-coral" style="position: absolute; top: 16px; right: 16px; font-size: 0.85rem; padding: 6px 14px;">خصم 40% ⚡</span>
          <button class="wishlist-btn" style="position: absolute; top: 16px; left: 16px;">♥</button>
        </div>

        <!-- Thumbnails Row -->
        <div class="thumbnails-row" style="display: flex; gap: 12px; margin-top: 16px;">
          <div class="thumb-item active" onclick="changeProductImage(this, 'https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=800&q=80')" style="width: 80px; height: 80px; border-radius: var(--radius-sm); overflow: hidden; border: 2px solid var(--color-primary); cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=150&q=80" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div class="thumb-item" onclick="changeProductImage(this, 'https://images.unsplash.com/photo-1547887537-6158d64c35b3?auto=format&fit=crop&w=800&q=80')" style="width: 80px; height: 80px; border-radius: var(--radius-sm); overflow: hidden; border: 2px solid transparent; cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1547887537-6158d64c35b3?auto=format&fit=crop&w=150&q=80" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div class="thumb-item" onclick="changeProductImage(this, 'https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=800&q=80')" style="width: 80px; height: 80px; border-radius: var(--radius-sm); overflow: hidden; border: 2px solid transparent; cursor: pointer;">
            <img src="https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=150&q=80" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
        </div>
      </div>

      <!-- Right Column: Product Details & Purchase Form -->
      <div class="product-info-col" style="display: flex; flex-direction: column; gap: 20px;">
        
        <div>
          <span class="badge badge-gold" style="margin-bottom: 8px;">الأكثر مبيعاً 🏆</span>
          <h1 style="font-size: 2rem; font-weight: 800; color: var(--color-text-main); line-height: 1.3;">
            عطر العود الملكي المعتّق - 100 مل
          </h1>
          <div style="display: flex; align-items: center; gap: 10px; margin-top: 10px; font-size: 0.9rem;">
            <div style="color: #F59E0B;">★★★★★</div>
            <span style="font-weight: 700;">4.9</span>
            <span style="color: var(--color-text-muted);">(148 تقييم موثّق من السعودية)</span>
            <span style="color: var(--color-primary); font-weight: 600; margin-inline-start: auto;">متوفر في المخزون ✓</span>
          </div>
        </div>

        <!-- Price Block -->
        <div style="background: var(--color-bg-secondary); padding: 18px 24px; border-radius: var(--radius-md); border: 1px solid var(--color-border); display: flex; align-items: baseline; justify-content: space-between;">
          <div>
            <span style="font-size: 2.2rem; font-weight: 900; color: var(--color-primary);">299 <span style="font-size: 1.1rem;">ر.س</span></span>
            <span style="font-size: 1.1rem; color: var(--color-text-light); text-decoration: line-through; margin-inline-start: 12px;">499 ر.س</span>
            <div style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 4px;">* السعر شامل ضريبة القيمة المضافة 15%</div>
          </div>
          <span class="badge badge-coral" style="font-size: 0.85rem; font-weight: 700;">وفر 200 ر.س</span>
        </div>

        <!-- KSA BNPL Widgets: Tamara & Tabby -->
        <div style="border: 1px solid rgba(55, 195, 146, 0.3); background: #F0FAF6; padding: 16px; border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 10px;">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 600;">
              <span style="background: #37C392; color: #fff; font-weight: 800; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">تمارا</span>
              قسمها على 4 دفعات بدون فوائد بقيمة <strong>74.75 ر.س / شهر</strong>
            </div>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px dashed rgba(0,0,0,0.1); padding-top: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 600;">
              <span style="background: #3BFFC4; color: #000; font-weight: 800; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">تابي</span>
              ادفع <strong>74.75 ر.س</strong> اليوم والباقي مقسّم شهرياً
            </div>
          </div>
        </div>

        <!-- Variant Options: Volume / Size Selector -->
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <label style="font-weight: 700; font-size: 0.95rem;">اختر الحجم:</label>
          <div style="display: flex; gap: 12px;">
            <button class="variant-btn active" style="padding: 10px 20px; border-radius: var(--radius-sm); border: 2px solid var(--color-primary); background: var(--color-primary-light); color: var(--color-primary); font-weight: 700; cursor: pointer;">100 مل (الأكثر طلباً)</button>
            <button class="variant-btn" style="padding: 10px 20px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: var(--color-bg-surface); color: var(--color-text-main); font-weight: 600; cursor: pointer;">50 مل</button>
            <button class="variant-btn" style="padding: 10px 20px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: var(--color-bg-surface); color: var(--color-text-main); font-weight: 600; cursor: pointer;">200 مل (حجم عائلي)</button>
          </div>
        </div>

        <!-- Quantity Selector & Purchase Action -->
        <div style="display: flex; gap: 16px; align-items: center; margin-top: 10px;">
          <div style="display: flex; align-items: center; border: 2px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-surface); padding: 4px;">
            <button onclick="decrementQty()" style="width: 36px; height: 36px; font-size: 1.2rem; font-weight: 700;">-</button>
            <input type="number" id="product-qty-val" value="1" min="1" style="width: 45px; text-align: center; font-weight: 800; font-size: 1rem;">
            <button onclick="incrementQty()" style="width: 36px; height: 36px; font-size: 1.2rem; font-weight: 700;">+</button>
          </div>

          <button class="btn btn-primary add-to-cart-btn" data-id="101" data-title="عطر العود الملكي المعتّق - 100 مل" data-price="299" data-image="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=400&q=80" style="flex: 1; padding: 14px; font-size: 1.05rem;">
            🛒 إضافة إلى السلة
          </button>
        </div>

        <!-- Express KSA Delivery & Trust Box -->
        <div style="background: var(--color-bg-main); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 16px; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.2rem;">🚚</span>
            <div>
              <strong>توصيل سريع داخل السعودية:</strong> صلّك إلى (الرياض، جدة، الدمام) خلال 24-48 ساعة.
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.2rem;">💵</span>
            <div>
              <strong>الدفع عند الاستلام (COD):</strong> متوفر لجميع مدن المملكة.
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.2rem;">🛡️</span>
            <div>
              <strong>ضمان ذهبي 100%:</strong> إمكانية الاسترجاع والاستبدال خلال 14 يوماً.
            </div>
          </div>
        </div>

        <!-- Description Accordion -->
        <div class="product-accordion" style="margin-top: 10px; border-top: 1px solid var(--color-border); padding-top: 20px;">
          <details open style="margin-bottom: 12px;">
            <summary style="font-weight: 700; font-size: 1rem; cursor: pointer; padding: 6px 0;">📝 وصف العطر والمكونات</summary>
            <p style="font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.7; margin-top: 8px;">
              عطر العود الملكي صُمم ببراعة ليعكس الفخامة والأصالة العربية. يمتزج فيه دهن العود الكلمنتان الطبيعي المعتّق مع نوتات الورد الطائفي الفاخر والعنبر الدافئ، ليمنحك حضوراً مستقلاً وفوحاناً يدوم طوال اليوم.
            </p>
          </details>

          <details style="margin-bottom: 12px;">
            <summary style="font-weight: 700; font-size: 1rem; cursor: pointer; padding: 6px 0;">✨ طريقة الاستخدام للحصول على ثبات أعلى</summary>
            <p style="font-size: 0.9rem; color: var(--color-text-muted); line-height: 1.7; margin-top: 8px;">
              يُرش العطر على نقاط النبض (المعصمين، جانبي الرقبة، وخلف الأذنين) من مسافة 15 سم. يُفضل استخدامه بعد الاستحمام مباشرةً لثبات يدوم أكثر من 24 ساعة.
            </p>
          </details>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
function changeProductImage(thumb, src) {
  document.querySelectorAll('.thumb-item').forEach(el => el.style.borderColor = 'transparent');
  thumb.style.borderColor = 'var(--color-primary)';
  const mainImg = document.getElementById('main-product-img');
  if (mainImg) {
    mainImg.style.opacity = '0.3';
    setTimeout(() => {
      mainImg.src = src;
      mainImg.style.opacity = '1';
    }, 150);
  }
}

function incrementQty() {
  const el = document.getElementById('product-qty-val');
  if (el) el.value = parseInt(el.value || '1') + 1;
}

function decrementQty() {
  const el = document.getElementById('product-qty-val');
  if (el && parseInt(el.value || '1') > 1) el.value = parseInt(el.value) - 1;
}
</script>

{% schema %}
{
  "name": "Main Product Details",
  "settings": []
}
{% endschema %}
