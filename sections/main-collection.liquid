<div class="collection-page" id="CollectionPage">

  <!-- Collection Header -->
  <div class="collection-header">
    <div class="container">
      <h1 class="collection-title">
        {{ collection.title }}
      </h1>
      {%- if collection.description != blank -%}
        <div class="collection-desc mt-auto" style="margin-top: 8px; color: var(--clr-muted); max-width: 600px;">
          {{ collection.description }}
        </div>
      {%- endif -%}
      <p class="collection-count">
        {%- if request.locale.iso_code == 'ar' -%}
          عرض {{ collection.products_count }} منتج
        {%- else -%}
          Showing {{ collection.products_count }} products
        {%- endif -%}
      </p>
    </div>
  </div>

  <div class="container section-padding-sm">

    <!-- Toolbar: Mobile Filter Toggle + Sort Dropdown -->
    <div class="collection-toolbar">
      <button class="filter-btn d-lg-none" id="mobileFilterToggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <span>{% if request.locale.iso_code == 'ar' %}الفلاتر والتصفية{% else %}Filters{% endif %}</span>
      </button>

      <div class="sort-wrapper d-flex align-center gap-8 ms-auto">
        <label for="SortBy" class="fs-14 fw-500 d-none d-sm-block">
          {% if request.locale.iso_code == 'ar' %}ترتيب حسب:{% else %}Sort by:{% endif %}
        </label>
        <select name="sort_by" id="SortBy" class="sort-select">
          <option value="manual">{% if request.locale.iso_code == 'ar' %}المميز{% else %}Featured{% endif %}</option>
          <option value="best-selling">{% if request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}Best Selling{% endif %}</option>
          <option value="title-ascending">{% if request.locale.iso_code == 'ar' %}الأبجدي (أ-ي){% else %}Alphabetically (A-Z){% endif %}</option>
          <option value="title-descending">{% if request.locale.iso_code == 'ar' %}الأبجدي (ي-أ){% else %}Alphabetically (Z-A){% endif %}</option>
          <option value="price-ascending">{% if request.locale.iso_code == 'ar' %}السعر: من الأقل للأعلى{% else %}Price: Low to High{% endif %}</option>
          <option value="price-descending">{% if request.locale.iso_code == 'ar' %}السعر: من الأعلى للأقل{% else %}Price: High to Low{% endif %}</option>
          <option value="created-descending">{% if request.locale.iso_code == 'ar' %}الأحدث{% else %}Newest{% endif %}</option>
        </select>
      </div>
    </div>

    <!-- Main Layout: Sidebar + Grid -->
    <div class="collection-layout">

      <!-- Filter Sidebar -->
      <aside class="filter-sidebar" id="filterSidebar">
        <h3 class="fs-16 fw-700 mb-16" style="padding-bottom: 12px; border-bottom: 2px solid var(--clr-primary);">
          {% if request.locale.iso_code == 'ar' %}تصفية المنتجات{% else %}Filter Products{% endif %}
        </h3>

        <!-- Availability Filter -->
        <div class="filter-group">
          <p class="filter-group__title">{% if request.locale.iso_code == 'ar' %}التوفر{% else %}Availability{% endif %}</p>
          <label class="filter-option">
            <input type="checkbox" name="filter.v.availability" value="1">
            <span>{% if request.locale.iso_code == 'ar' %}متوفر بالمخزون{% else %}In Stock{% endif %}</span>
          </label>
        </div>

        <!-- Category Filter -->
        <div class="filter-group">
          <p class="filter-group__title">{% if request.locale.iso_code == 'ar' %}الفئات{% else %}Categories{% endif %}</p>
          {%- for col in collections -%}
            {%- unless col.handle == 'all' or col.handle == 'frontpage' -%}
              <label class="filter-option d-flex align-center gap-6">
                <input type="checkbox" name="filter.p.collection" value="{{ col.handle }}">
                <span>{{ col.title }}</span>
              </label>
            {%- endunless -%}
          {%- else -%}
            <label class="filter-option d-flex align-center gap-6">
              <input type="checkbox" name="filter.p.collection" value="electronics">
              <span>{% if request.locale.iso_code == 'ar' %}إلكترونيات{% else %}Electronics{% endif %}</span>
            </label>
            <label class="filter-option d-flex align-center gap-6">
              <input type="checkbox" name="filter.p.collection" value="fashion">
              <span>{% if request.locale.iso_code == 'ar' %}أزياء{% else %}Fashion{% endif %}</span>
            </label>
            <label class="filter-option d-flex align-center gap-6">
              <input type="checkbox" name="filter.p.collection" value="beauty">
              <span>{% if request.locale.iso_code == 'ar' %}جمال وعناية{% else %}Beauty{% endif %}</span>
            </label>
            <label class="filter-option d-flex align-center gap-6">
              <input type="checkbox" name="filter.p.collection" value="home-kitchen">
              <span>{% if request.locale.iso_code == 'ar' %}المنزل والمطبخ{% else %}Home & Kitchen{% endif %}</span>
            </label>
          {%- endfor -%}
        </div>

        <!-- Price Filter -->
        <div class="filter-group">
          <p class="filter-group__title">{% if request.locale.iso_code == 'ar' %}السعر (ر.س){% else %}Price (SAR){% endif %}</p>
          <div class="price-range-inputs">
            <input type="number" placeholder="{% if request.locale.iso_code == 'ar' %}من{% else %}From{% endif %}" class="price-range-input" min="0">
            <span>-</span>
            <input type="number" placeholder="{% if request.locale.iso_code == 'ar' %}إلى{% else %}To{% endif %}" class="price-range-input" min="0">
          </div>
        </div>

        <!-- COD Filter Tag -->
        <div class="filter-group">
          <p class="filter-group__title">{% if request.locale.iso_code == 'ar' %}طريقة الدفع{% else %}Payment Method{% endif %}</p>
          <label class="filter-option d-flex align-center gap-6">
            <input type="checkbox" name="filter.cod" value="1" checked>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;color:#27AE60;flex-shrink:0;"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><circle cx="12" cy="14" r="2"/></svg>
            <span>{% if request.locale.iso_code == 'ar' %}الدفع عند الاستلام{% else %}Cash on Delivery{% endif %}</span>
          </label>
        </div>
      </aside>

      <!-- Products Grid -->
      <div class="collection-products">
        {%- paginate collection.products by 16 -%}
          {%- if collection.products_count > 0 -%}
            <div class="product-grid">
              {%- for product in collection.products -%}
                {% render 'card-product', card_product: product %}
              {%- endfor -%}
            </div>

            <!-- Pagination -->
            {%- if paginate.pages > 1 -%}
              <div class="pagination d-flex justify-center align-center gap-12" style="margin-top: 48px;">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="btn btn-outline btn-sm">
                    {% if request.locale.iso_code == 'ar' %}← السابق{% else %}← Previous{% endif %}
                  </a>
                {%- endif -%}

                <span class="fs-14 fw-600">
                  {{ paginate.current_page }} / {{ paginate.pages }}
                </span>

                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="btn btn-primary btn-sm">
                    {% if request.locale.iso_code == 'ar' %}التالي →{% else %}Next →{% endif %}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- else -%}
            <div class="no-results">
              <div class="no-results__icon">🛍️</div>
              <h2 class="no-results__title">
                {% if request.locale.iso_code == 'ar' %}لا توجد منتجات في هذه الفئة{% else %}No products found in this collection{% endif %}
              </h2>
              <p class="no-results__text">
                {% if request.locale.iso_code == 'ar' %}جرّب تصفح فئات أخرى أو العودة للرئيسية{% else %}Try browsing other categories or back to home{% endif %}
              </p>
              <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg">
                {% if request.locale.iso_code == 'ar' %}العودة للرئيسية{% else %}Back to Home{% endif %}
              </a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

    </div>
  </div>
<script>
  (function() {
    // 1. Sync checkboxes state from URL parameters on page load
    var url = new URL(window.location.href);
    var filterCheckboxes = document.querySelectorAll('.filter-option input[type="checkbox"]');
    
    filterCheckboxes.forEach(function(checkbox) {
      var name = checkbox.name;
      var value = checkbox.value;
      // Skip hardcoded checked default for COD (if not explicitly disabled)
      if (name === 'filter.cod' && !url.searchParams.has('filter.cod')) {
        checkbox.checked = true;
        return;
      }
      var activeValues = url.searchParams.getAll(name);
      if (activeValues.includes(value)) {
        checkbox.checked = true;
      } else if (name !== 'filter.cod') {
        checkbox.checked = false;
      }
    });

    // 2. Handle checkbox change submissions
    filterCheckboxes.forEach(function(checkbox) {
      checkbox.addEventListener('change', function() {
        var name = this.name;
        var value = this.value;
        if (this.checked) {
          url.searchParams.append(name, value);
        } else {
          var params = url.searchParams.getAll(name);
          url.searchParams.delete(name);
          params.forEach(function(val) {
            if (val !== value) {
              url.searchParams.append(name, val);
            }
          });
        }
        window.location.href = url.toString();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Page",
  "class": "section-main-collection",
  "settings": []
}
{% endschema %}
