{%- if settings.announcement_enabled -%}
  <div class="announcement-bar" id="announcement-bar" data-section-id="{{ section.id }}">
    <div class="announcement-bar__slides" id="announcementSlides">

      <div class="announcement-bar__slide is-active" id="anno-slide-0">
        <span>
          {%- if request.locale.iso_code == 'ar' -%}
            {{ section.settings.text_1_ar | default: '🚚 شحن مجاني للطلبات فوق 200 ر.س' }}
          {%- else -%}
            {{ section.settings.text_1_en | default: 'Free Shipping on orders over 200 SAR' }}
          {%- endif -%}
        </span>
      </div>

      {%- if section.settings.text_2_ar != blank or section.settings.text_2_en != blank -%}
        <div class="announcement-bar__slide" id="anno-slide-1">
          <span>
            {%- if request.locale.iso_code == 'ar' -%}
              {{ section.settings.text_2_ar }}
            {%- else -%}
              {{ section.settings.text_2_en }}
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- if section.settings.text_3_ar != blank or section.settings.text_3_en != blank -%}
        <div class="announcement-bar__slide" id="anno-slide-2">
          <span>
            {%- if request.locale.iso_code == 'ar' -%}
              {{ section.settings.text_3_ar }}
            {%- else -%}
              {{ section.settings.text_3_en }}
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}

    </div>

    <button class="announcement-bar__close" id="announcementClose" aria-label="Close announcement">×</button>
  </div>

  <style>
    #announcement-bar {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
    }
  </style>

  <script>
    (function() {
      var bar = document.getElementById('announcement-bar');
      var close = document.getElementById('announcementClose');
      var slides = bar ? bar.querySelectorAll('.announcement-bar__slide') : [];
      var currentSlide = 0;

      if (close) {
        close.addEventListener('click', function() {
          bar.style.display = 'none';
          sessionStorage.setItem('layvora_anno_closed', '1');
        });
      }

      if (sessionStorage.getItem('layvora_anno_closed')) {
        if (bar) bar.style.display = 'none';
      }

      if (slides.length > 1) {
        setInterval(function() {
          slides[currentSlide].classList.remove('is-active');
          currentSlide = (currentSlide + 1) % slides.length;
          slides[currentSlide].classList.add('is-active');
        }, 4000);
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1A1A2E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "text_1_ar",
      "label": "Message 1 (Arabic)",
      "default": "🚚 شحن مجاني للطلبات فوق 200 ر.س"
    },
    {
      "type": "text",
      "id": "text_1_en",
      "label": "Message 1 (English)",
      "default": "Free Shipping on orders over 200 SAR"
    },
    {
      "type": "text",
      "id": "text_2_ar",
      "label": "Message 2 (Arabic)",
      "default": "💰 الدفع عند الاستلام متاح"
    },
    {
      "type": "text",
      "id": "text_2_en",
      "label": "Message 2 (English)",
      "default": "Cash on Delivery Available"
    },
    {
      "type": "text",
      "id": "text_3_ar",
      "label": "Message 3 (Arabic)",
      "default": "🔥 عروض حصرية يومياً"
    },
    {
      "type": "text",
      "id": "text_3_en",
      "label": "Message 3 (English)",
      "default": "Exclusive Daily Deals"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
